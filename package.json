{
  "name": "vue3-histogram-slider",
  "version": "0.4.15",
  "description": "Range slider with histogram for Vue 3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "prepare": "yarn build",
    "prepublishOnly": "yarn lint && yarn build"
  },
  "main": "dist/histogram-slider.umd.js",
  "dependencies": {
    "@vue/compat": "^3.5.39",
    "core-js": "^3.6.5",
    "d3-array": "^3.2.4",
    "d3-brush": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "jquery": "3.5",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.1.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "autoprefixer": "^10.5.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "lint-staged": "^17.0.8",
    "prettier": "^2.2.1",
    "vite": "^8.1.2"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "keywords": [
    "vue",
    "vuejs",
    "slider",
    "range-slider",
    "histogram",
    "histogram-slider"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,vue}": [
